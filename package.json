{
  "name": "fme-ai-bank-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Northwind Bank — a mock fintech app with an AI assistant, built to demo Harness FME differentiation.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "gen:fixtures": "tsx scripts/generate-fixtures.ts",
    "seed-events:staging": "tsx --env-file=.env.local scripts/seed-event-types.ts --env staging",
    "seed-events:prod": "tsx --env-file=.env.local scripts/seed-event-types.ts --env production",
    "hydrate:staging": "tsx --env-file=.env.local scripts/experiment-hydrator.ts --env staging",
    "hydrate:prod": "tsx --env-file=.env.local scripts/experiment-hydrator.ts --env production"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.103.0",
    "@splitsoftware/splitio": "^11.11.2",
    "better-sqlite3": "^12.10.0",
    "next": "^16.2.9",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "tsx": "^4.23.1",
    "typescript": "5.5.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.4": true
  }
}

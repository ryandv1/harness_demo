# Copy this file to .env.local and fill in what you have. ALL keys are optional:
# the app runs fully in "mock mode" with none of them set.

# --- AI assistant (optional) ---
# Without this, the assistant returns deterministic canned answers from your data.
ANTHROPIC_API_KEY=

# --- Harness FME (added in Phase 1; optional, app uses a mock flag client without it) ---
# Server-side SDK key from your FME environment.
FME_SDK_KEY=

# Which FME environment this key belongs to — purely a UI label for the "flags on
# this page" footer (Staging vs Production). The SDK key is per-environment but the
# env can't be inferred from it, so set this to "staging" or "production". Unset (or
# in mock mode) the footer shows "Mock"; an unexpanded "${...}" value is ignored.
FME_ENVIRONMENT=

# --- Experiment Hydrator (Phase 2 Path B; optional, maintainer/demo utility) ---
# Per-environment server-side SDK keys used by `npm run hydrate:staging|prod` (and
# `seed-events:*`) to push real impressions + events into FME's Experimentation view.
# Get these from the FME console (Admin Settings → API keys → server-side SDK key for
# each env). Either spelling works per env (first usable wins); falls back to
# FME_SDK_KEY above. An unexpanded "${...}" value is ignored (fails fast, won't hang).
FME_SDK_KEY_STAGING=
# FME_SDK_KEY_STG=            # short alias, also accepted for staging
FME_SDK_KEY_PRODUCTION=
# FME_SDK_KEY_PROD=           # short alias, also accepted for production
